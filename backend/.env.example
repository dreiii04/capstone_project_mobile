NODE_ENV=
PORT=
# Comma-separated HTTPS origins for web clients. Native mobile clients do not
# need an entry. Example: https://app.example.com,https://preview.example.com
ALLOWED_ORIGIN=

MONGODB_URI=
# Must match the web backend deployment. Current production data uses "test".
MONGODB_DB_NAME=test
MONGODB_ALUMNI_COLLECTION=
MONGODB_STUDENTS_COLLECTION=
RUN_DB_MIGRATIONS=
DISABLE_DB=

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_MINUTES=
JWT_REFRESH_TTL_DAYS=

OTP_TTL_MINUTES=
OTP_DEV_MODE=
MAILBOXLAYER_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NOTIFICATIONS_API_KEY=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TRUST_PROXY_HOPS=
